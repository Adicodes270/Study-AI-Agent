# =============================================================================
# Study Agent - Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# ─── Required: Telegram Bot ──────────────────────────────────────────────────
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ─── Required: Database (Neon Postgres) ──────────────────────────────────────
# Format: postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# ─── Required: Gemini API ────────────────────────────────────────────────────
# Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: override model (default: gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-3.5-flash-lite

# ─── Optional: Default class level for syllabus parsing ──────────────────────
# CLASS_LEVEL=10

# ─── Required for Worker: Session Encryption Key ─────────────────────────────
# Generate once: python -c "import secrets; print(secrets.token_hex(32))"
# MUST be identical for Node app and Python worker!
SESSION_ENC_KEY=your_64_char_hex_key_here

# ─── Optional: Worker Tuning ─────────────────────────────────────────────────
# WORKER_POLL_SECONDS=60
# WORKER_MAX_SOURCES=3
# WORKER_MAX_STARTS=5
# WORKER_MAX_NOTEBOOKS=50
# WORKER_MAX_ATTEMPTS=5
# WORKER_RUNNING_TIMEOUT=45

# ─── Optional: Browserbase (for cloud NotebookLM sign-in on public site) ─────
# BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=
# BROWSERBASE_API_KEY_BACKUP=
# BROWSERBASE_PROJECT_ID_BACKUP=
# BROWSERBASE_PROXIES=true
# BROWSERBASE_MAX_SESSIONS=3
# BROWSERBASE_REGION=