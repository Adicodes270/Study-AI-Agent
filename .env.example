DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
CLASS_LEVEL=9
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# Optional second account, used when the first can't start a session
BROWSERBASE_API_KEY_BACKUP=
BROWSERBASE_PROJECT_ID_BACKUP=
APP_TIMEZONE=Asia/Kolkata

# Study Agent Schedule & Quiet Hours (24-hour IST)
AGENT_TICK_TIME_MORNING=08:00
AGENT_TICK_TIME_EVENING=20:00
QUIET_HOURS_START=22:00
QUIET_HOURS_END=07:00

# Study Agent Rate Limits & Controls
AGENT_MAX_MESSAGES_PER_DAY=3
AGENT_MAX_STEPS=4
AGENT_MAX_CALLS_PER_USER_PER_DAY=20
AGENT_TICK_DELAY_MS=50
DRY_RUN=false
